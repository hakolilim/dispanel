# Recommended in production. Generate a unique value, for example with:
# openssl rand -base64 48
# If omitted, a secure ephemeral value is generated and sessions reset on restart.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Recommended in production for strict HTTP and WebSocket origin checks.
PUBLIC_ORIGIN=https://panel.example.com

# Optional in development. Comma-separated extra hosts accepted by Vite.
ALLOWED_HOSTS=

# Required only by Drizzle schema commands such as `npm run db:push`.
DATABASE_URL=postgresql://user:password@localhost:5432/dispanel
